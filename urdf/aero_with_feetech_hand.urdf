  <link name="r_feetech_middle_pulley_link">
    <inertial>
      <origin rpy="0 0 0" xyz="5.36147333676171e-05 -5.3836901163673e-05 -0.000552318187598586"/>
      <mass value="0.0010766893572167"/>
      <inertia ixx="2.21586596253831e-08" ixy="-2.31408490056431e-10" ixz="-7.38804536414854e-12" iyy="2.21540492822443e-08" iyz="7.5170062793006e-12" izz="4.25056471041653e-08"/>
