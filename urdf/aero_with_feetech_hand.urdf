  <!-- ============================   hand_yaw   ============================ -->
  <!-- prefix is "r" or "l" -->
  <!-- reflect=1 is rightside, reflect=-1 is leftside -->
  <link name="r_hand_yaw_link">
    <visual>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0.0 0 0"/>
      <geometry>
        <mesh filename="package://aero_description/typeJSK/meshes/hand_yaw/wrist.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://aero_description/typeJSK/meshes/hand_yaw/wrist.dae" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.183"/>
      <!-- original version -->
      <!--origin xyz="0 0 -0.0875" rpy="0 -0 0"/>
      <inertia ixx="0.000601" ixy="0" ixz="0" iyy="0.00055" iyz="0" izz="0.000102"/-->
      <!-- just fixed for gazebo / aim to increase z axis inertia-->
      <origin rpy="0 -0 0" xyz="0 0.014 -0.02"/>
