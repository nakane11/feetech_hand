  <xacro:feetech_hand prefix="l_feetech" parent="l_hand_link" mount_xyz="-0.01 -0.004 -0.01" mount_rpy="0 1.5707963267948966 0" reflect="-1" mesh_scale="1 -1 1"/>
</robot>
