<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aero_with_feetech_hand">
  <!--AERO nohand with Feetech hands attached to r_hand_link and l_hand_link.-->
  <xacro:include filename="/home/leus/.skrobot/aero_description/typeJSK/urdf/aero_nohand.urdf"/>
  <xacro:include filename="/home/leus/ros/hand/src/feetech_hand/urdf/feetech_hand.xacro"/>
